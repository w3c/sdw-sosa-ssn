"""Repository integrity checks for the SOSA/SSN specification.

Written in Linked-Data Python (ldpy): a superset of Python in which Turtle
notation is part of the syntax.  Run it with::

    pip install linked-data-python
    python -m ldpy ssn/scripts/check_repository.ldpy

Checks marked FATAL make the script exit non-zero; the others are reported as
warnings, because the repository legitimately carries drafts and spare files.
"""

@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

import difflib
import html
import re
import subprocess
import sys
from collections import defaultdict
from datetime import datetime, timezone
from pathlib import Path

from rdflib import Graph, URIRef

# ---------------------------------------------------------------------------
# Where things live
# ---------------------------------------------------------------------------

SSN_DIR = Path("ssn")
CHAPTERS_DIR = SSN_DIR / "chapters"
IMAGES_DIR = SSN_DIR / "images"
ONTOLOGY_DIR = SSN_DIR / "rdf" / "ontology"
VOCABULARIES_DIR = SSN_DIR / "rdf" / "vocabularies"
EXAMPLES_DIR = SSN_DIR / "rdf" / "examples"

# The two namespaces the specification is responsible for.  A bare `sosa:` is
# not a term outside an island, so the strings needed by `startswith` are taken
# from the IRIs themselves rather than retyped.
SOSA_NS = str(<http://www.w3.org/ns/sosa/>)
SSN_NS = str(<http://www.w3.org/ns/ssn/>)

# The two property registries are rendered as tables, with no anchor and no
# prose per term.  That is an editorial choice, so the checks that expect a
# documenting section skip them.
VOCABULARY_NS = (str(<http://www.w3.org/ns/sosa/system-capability-properties#>),
                 str(<http://www.w3.org/ns/sosa/system-environment-properties#>))


def is_ours(term):
    """True for a URIRef in the SOSA or SSN namespace (extensions included)."""
    return isinstance(term, URIRef) and str(term).startswith((SOSA_NS, SSN_NS))


def module_iris(graph):
    """The IRIs that name a module rather than a term.

    An ontology IRI, a version IRI and anything imported all live in the SOSA
    and SSN namespaces too, so they have to be told apart from terms before
    anything is said about which terms are defined where.
    """
    @graph graph
    return (set(m{ ?o a owl:Ontology })
            | {o for s, o in m{ ?s owl:versionIRI ?o }}
            | {o for s, o in m{ ?s owl:imports ?o }}
            | {o for s, o in m{ ?s owl:priorVersion ?o }})


def anchor_matches(anchor, term):
    """True when `anchor` is the documentation anchor for `term`.

    Anchors are the term's local name behind a module prefix in capitals:
    `SOSASensor`, `SSNhasProperty`, `OMSpreparedSample`. The match has to be
    exact — testing that the anchor merely ends with the local name makes
    `SOSAActuatingProcedure` answer for `sosa:Procedure`.
    """
    return re.fullmatch(r"[A-Z]{2,6}" + re.escape(local_name(term)), anchor) is not None


def local_name(term):
    """`Sensor` for sosa:Sensor, `metadata` for the oms: extension term."""
    return re.split(r"[/#]", str(term))[-1]


def ontology_files():
    return sorted(ONTOLOGY_DIR.rglob("*.ttl")) + sorted(VOCABULARIES_DIR.rglob("*.ttl"))


def html_files():
    """Every source HTML file, minus the generated usage report."""
    return [f for f in sorted(SSN_DIR.rglob("*.html")) if "usage" not in f.parts]


def read(path):
    return path.read_text(encoding="utf-8", errors="replace")


# ---------------------------------------------------------------------------
# Reporting
# ---------------------------------------------------------------------------

FAILURES = []


def report(title, problems, all_good, fatal=False, detail=None):
    """Print one section.  `problems` is a list; `detail` renders one item."""
    print(f"\n=== {title} ===")
    if not problems:
        print(f"{all_good} 🎉")
        return
    print("❌" if fatal else "⚠️ ", f"{len(problems)} issue(s)")
    for item in problems:
        print(detail(item) if detail else f"- {item}")
    if fatal:
        FAILURES.append(title)


# ---------------------------------------------------------------------------
# Files and references — plain Python: no RDF here, so no island either
# ---------------------------------------------------------------------------

def unused_html_chapters():
    """Chapter files that no document pulls in with `data-include`."""
    pattern = re.compile(r'data-include=["\']\./chapters/(.*?)\.html["\']')
    included = set()
    for file in html_files():
        if CHAPTERS_DIR not in file.parents:
            included.update(pattern.findall(read(file)))
    return sorted({f.stem for f in CHAPTERS_DIR.glob("*.html")} - included)


def unreferenced_images():
    pattern = re.compile(r'src=["\'](?:\./)?images/([^"\']+)["\']')
    exts = {".svg", ".png", ".jpg", ".jpeg", ".gif"}
    on_disk = {f.name for f in IMAGES_DIR.glob("*") if f.is_file() and f.suffix.lower() in exts}
    used = set()
    for file in html_files():
        used.update(pattern.findall(read(file)))
    return sorted(on_disk - used)


def unreferenced_ttl_files():
    """Example and data files no document links to.  Ontologies are exempt:
    they are published by IRI, not by link."""
    pattern = re.compile(r'(?:href|data-include)=["\']([^"\']+?\.ttl)["\']')
    on_disk = {f.resolve() for f in Path(".").rglob("*.ttl") if "ontology" not in f.parts}
    used = set()
    for file in html_files():
        for match in pattern.findall(read(file)):
            if not re.match(r"^\w+://", match):          # skip absolute URLs
                used.add((SSN_DIR / match).resolve())
    return sorted(on_disk - used)


def dangling_anchors():
    """`href="#x"` with no `id="x"` anywhere in the document sources."""
    ids, hrefs = set(), {}
    for file in html_files():
        content = read(file)
        ids.update(re.findall(r'id="([^"]+)"', content))
        for target in re.findall(r'href="#([^"]+)"', content):
            hrefs.setdefault(target, file)
    return sorted((t, hrefs[t]) for t in hrefs if t not in ids)


# ---------------------------------------------------------------------------
# The ontology — one graph per file, then one graph for the whole thing
# ---------------------------------------------------------------------------

def invalid_ttl_files():
    broken = []
    for file in sorted(Path(".").rglob("*.ttl")):
        try:
            Graph().parse(file, format="turtle")
        except Exception as error:
            broken.append((file, str(error)))
    return broken


def load_ontology():
    """Parse every ontology file once, and record what each one declares.

    Returns the merged graph, the ontology IRI declared by each file, and the
    files a term was seen in.
    """
    merged = Graph()
    declared_by = {}                       # ontology IRI -> file declaring it
    seen_in = defaultdict(set)             # term -> files mentioning it
    problems = []

    for file in ontology_files():
        @graph as module
        module.parse(file, format="turtle")

        ontologies = list(m{ ?o a owl:Ontology })
        if len(ontologies) != 1:
            problems.append((file, f"{len(ontologies)} owl:Ontology declarations, expected 1"))
            continue
        declared_by[ontologies[0]] = file

        for term in {t for triple in module for t in triple if is_ours(t)}:
            seen_in[term].add(file)

        merged += module

    for iri in module_iris(merged):
        seen_in.pop(iri, None)

    return merged, declared_by, seen_in, problems


def check_publication(merged, declared_by):
    """What the namespace tree needs from us.

    w3c/ns serves a module at the path of its ontology IRI, under the directory
    of its edition: `http://www.w3.org/ns/sosa/act/` is served from
    `sosa/<edition>/act/`, and its version IRI is
    `http://www.w3.org/ns/sosa/<edition>/act/`.  Two things have to hold for a
    module to be publishable that way, and the table of what each file declares
    is what an editor reads to check the third.
    """
    print("\n=== Ontology Declarations ===")
    for iri, file in sorted(declared_by.items(), key=lambda item: (str(item[1]), str(item[0]))):
        print(f"- <{iri}>: {file}")

    homeless = sorted(iri for iri in declared_by
                      if not str(iri).startswith((SOSA_NS, SSN_NS)))
    report(
        "Ontologies that cannot be published under /ns/", homeless,
        "Every ontology has a home in the W3C namespace tree", fatal=False,
        detail=lambda iri: f"- <{iri}> declared in {declared_by[iri]}",
    )

    @graph merged
    odd = []
    for ontology, version in m{ ?ontology owl:versionIRI ?version }:
        base = next((ns for ns in (SOSA_NS, SSN_NS) if str(ontology).startswith(ns)), None)
        if base is None:
            continue
        tail = str(ontology)[len(base):]
        if not str(version).startswith(base):
            odd.append((ontology, version, f"{base}<edition>/{tail}"))
            continue
        edition, _, rest = str(version)[len(base):].partition("/")
        if not edition or rest != tail:
            odd.append((ontology, version, f"{base}<edition>/{tail}"))
    report(
        "Version IRIs that do not name an edition of their ontology", sorted(odd),
        "Every version IRI is its ontology IRI, one edition down", fatal=False,
        detail=lambda x: f"- <{x[0]}> declares owl:versionIRI <{x[1]}>, expected <{x[2]}>",
    )


def check_terms(merged, declared_by, seen_in):
    """Every SOSA/SSN term must be declared by exactly one declared ontology."""
    @graph merged

    defines = defaultdict(set)             # term -> ontologies defining it
    for term, ontology in m{ ?term rdfs:isDefinedBy ?ontology }:
        defines[term].add(ontology)

    duplicates = sorted((t, sorted(o)) for t, o in defines.items() if len(o) > 1)
    report(
        "Terms defined by more than one ontology", duplicates,
        "Every term has a single home", fatal=True,
        detail=lambda x: f"- {x[0]}\n" + "\n".join(f"    - {o}" for o in x[1]),
    )

    undefined = sorted(t for t in seen_in if t not in defines)
    report(
        "Terms used but never defined", undefined,
        "No undefined term", fatal=True,
        detail=lambda t: f"- {t} used in:\n" + "\n".join(f"    - {f}" for f in sorted(seen_in[t])),
    )

    orphans = sorted(
        (o, sorted(t for t in defines if o in defines[t]))
        for o in {o for ontos in defines.values() for o in ontos} - set(declared_by)
    )
    report(
        "Terms defined by an ontology that is declared nowhere", orphans,
        "Every term's home ontology exists", fatal=True,
        detail=lambda x: f"- <{x[0]}> is declared in no file, yet defines:\n"
                         + "\n".join(f"    - {t}" for t in x[1]),
    )

    return defines


def check_annotations(merged, defines, deprecated):
    """Each live term carries a label and a definition.

    Deprecated terms are exempt: they are kept for resolution, not for reading.
    """
    @graph merged
    missing = sorted(
        (term, [k for k, present in (("rdfs:label", bool(m{ {term} rdfs:label ?l })),
                                     ("skos:definition", bool(m{ {term} skos:definition ?d })))
                if not present])
        for term in defines if term not in deprecated
    )
    missing = [x for x in missing if x[1]]
    report(
        "Terms missing a label or a definition", missing,
        "Every live term is labelled and defined", fatal=True,
        detail=lambda x: f"- {x[0]} has no {' and no '.join(x[1])}",
    )


def check_domains_and_ranges(merged, defines):
    """A domain or range in our own namespace must be a term we define."""
    @graph merged
    targets = {(p, o, "domain") for p, o in m{ ?p rdfs:domain ?o }}
    targets |= {(p, o, "range") for p, o in m{ ?p rdfs:range ?o }}
    dangling = sorted((p, o, kind) for p, o, kind in targets if is_ours(o) and o not in defines)
    report(
        "Undefined terms used as a domain or a range", dangling,
        "Every domain and range resolves", fatal=True,
        detail=lambda x: f"- {x[0]} rdfs:{x[2]} {x[1]}, which is not defined",
    )


def check_deprecated(merged, defines):
    """A term whose home is a `*-deprecated` module says so, and vice versa."""
    @graph merged
    marked = set(m{ ?term owl:deprecated true })
    in_deprecated_module = {t for t, ontologies in defines.items()
                            if any("dep/" in str(o) for o in ontologies)}

    report(
        "Deprecated modules holding unmarked terms", sorted(in_deprecated_module - marked),
        "Every deprecated term carries owl:deprecated true", fatal=True,
    )
    report(
        "Terms marked deprecated outside a deprecated module", sorted(marked - in_deprecated_module),
        "Deprecation marks and modules agree", fatal=False,
    )
    return marked


def check_documented(defines, deprecated):
    """Every live ontology term has an anchor in the specification text."""
    anchors = set()
    for file in html_files():
        anchors.update(re.findall(r'id="([^"]+)"', read(file)))

    undocumented = sorted(
        term for term in defines
        if term not in deprecated
        and not str(term).startswith(VOCABULARY_NS)
        and not any(anchor_matches(a, term) for a in anchors)
    )
    report(
        "Ontology terms with no anchor in the specification", undocumented,
        "Every live term is documented", fatal=True,
        detail=lambda t: f"- {t} — expected an id ending in '{local_name(t)}'",
    )


# ---------------------------------------------------------------------------
# The ontology and the prose, side by side
# ---------------------------------------------------------------------------
#
# Each term is described twice: as `skos:definition` in Turtle, and as prose in
# the chapter that documents it.  The two drift apart one edit at a time, so
# they are compared here — on the text alone.  Markup, entities, whitespace,
# the flavour of dash or quote, and the numbering of a list are all normalised
# away before anything is compared; wording and punctuation are not, because
# those are the content.

SPECTERM = re.compile(
    r'<section[^>]*\bclass="[^"]*\bspecterm\b[^"]*"[^>]*\bid="([^"]+)"', re.I)
BLOCK_END = re.compile(r'(</(?:p|li|dd|dt|h[1-6]|div|section|td)>|<br\s*/?>)', re.I)
SENTENCE_SPLIT = re.compile(r'(?<=[.;:])\s+')


def plain(text):
    """Markup and typography out; wording and punctuation in."""
    text = html.unescape(re.sub(r"<[^>]+>", " ", text))
    for fancy, plainer in (("\u2014", " - "), ("\u2013", " - "), ("--", " - "),
                           ("\u2019", "'"), ("\u201c", '"'), ("\u201d", '"')):
        text = text.replace(fancy, plainer)
    text = re.sub(r"\s+", " ", text)
    text = re.sub(r"\s+([,.;:!?)])", r"\1", text)   # markup leaves a gap here
    text = re.sub(r"([(])\s+", r"\1", text)
    return text.strip()


def term_name_folder(defines):
    """A normaliser that spells every term name the one way.

    The prose writes a class as `sosa:ActuationCollection`, the Turtle spells it
    out as "Actuation Collection"; both name the same term, and neither spelling
    is a change of meaning.  Folding them together is what leaves only the
    differences worth an editor's attention.
    """
    names = sorted({local_name(t) for t in defines}, key=len, reverse=True)
    prefixed = re.compile(r"\b[a-z][a-zA-Z0-9-]*:(?=(?:" + "|".join(map(re.escape, names)) + r")\b)")
    spaced = [(re.compile(r"\b" + r"\s+".join(re.findall(r"[A-Z][a-z0-9]*|[a-z0-9]+", n)) + r"\b"), n)
              for n in names if len(re.findall(r"[A-Z][a-z0-9]*|[a-z0-9]+", n)) > 1]

    def fold(text):
        text = prefixed.sub("", text)
        for pattern, name in spaced:
            text = pattern.sub(name, text)
        return text

    return fold


def definition_paragraphs(definition):
    """The paragraphs of a `skos:definition`, as (raw, comparable) pairs.

    The raw form is kept so the paragraph can be found again in the Turtle
    file, which is what makes `git blame` possible on the lines that carry it.
    """
    for paragraph in re.split(r"\n\s*\n", str(definition)):
        comparable = plain(re.sub(r"^\s*\d+[.)]\s*", "", paragraph))
        if comparable:
            yield paragraph.strip(), comparable


def specterm_sections():
    """`id` of each term section -> (file, flat text, blocks).

    A block is `(comparable text, first line, last line)`, so a paragraph that
    differs can be traced to the lines that hold it.  A section runs to the
    next `specterm` section, which is enough: they are siblings, one per term.
    """
    sections = {}
    for file in sorted(CHAPTERS_DIR.glob("*.html")):
        content = read(file)
        starts = list(SPECTERM.finditer(content))
        for i, start in enumerate(starts):
            end = starts[i + 1].start() if i + 1 < len(starts) else len(content)
            raw = content[start.end():end]

            # The pattern captures its delimiters, so every character of `raw`
            # comes back and the running offset stays true to the file.
            blocks, offset = [], start.end()
            for piece in BLOCK_END.split(raw):
                text = "" if BLOCK_END.fullmatch(piece) else plain(piece)
                if len(text) > 15:
                    lead = len(piece) - len(piece.lstrip())
                    first = content.count("\n", 0, offset + lead) + 1
                    blocks.append((text, first, first + piece.strip().count("\n")))
                offset += len(piece)

            sections[start.group(1)] = (file, plain(raw), blocks)
    return sections


# ---------------------------------------------------------------------------
# Which side was edited last
# ---------------------------------------------------------------------------
#
# When the Turtle and the prose disagree, the useful question is not that they
# differ but which one somebody changed last: that is almost always the side
# carrying the intended wording, and the other is the one that was forgotten.

BLAME_CACHE = {}


def blame(file):
    """line number -> (commit time, short sha, subject), from `git blame`."""
    path = str(file)
    if path not in BLAME_CACHE:
        lines = {}
        try:
            output = subprocess.run(
                ["git", "blame", "--line-porcelain", "--", path],
                capture_output=True, text=True, check=True).stdout
        except (subprocess.CalledProcessError, FileNotFoundError):
            BLAME_CACHE[path] = lines           # not a checkout, or not tracked
            return lines

        sha = subject = None
        when = 0
        for line in output.splitlines():
            header = re.match(r"^([0-9a-f]{40}) \d+ (\d+)", line)
            if header:
                sha, number = header.group(1)[:8], int(header.group(2))
            elif line.startswith("committer-time "):
                when = int(line.split(" ", 1)[1])
            elif line.startswith("summary "):
                subject = line.split(" ", 1)[1]
            elif line.startswith("\t") and sha:
                lines[number] = (when, sha, subject)
        BLAME_CACHE[path] = lines
    return BLAME_CACHE[path]


def last_touched(file, first, last):
    """The most recent commit among a range of lines."""
    lines = blame(file)
    touches = [lines[n] for n in range(first, last + 1) if n in lines]
    return max(touches) if touches else None


def describe(touch):
    if touch is None:
        return "unknown"
    when, sha, subject = touch
    date = datetime.fromtimestamp(when, tz=timezone.utc).date().isoformat()
    return f"{date} {sha} {subject}"


def locate_in_turtle(file, term, raw_paragraph):
    """The line range a definition paragraph occupies in its Turtle file.

    The search starts at the term's own block, because the collection rules
    repeat the same sentences under several terms of the same file and the
    first occurrence is rarely the right one.
    """
    content = read(file)
    block = re.search(r"^\S*[:/]" + re.escape(local_name(term)) + r"\s*$",
                      content, re.M)
    start = block.start() if block else 0

    needle = raw_paragraph.strip().splitlines()[0].strip()
    if len(needle) < 12:
        return None
    offset = content.find(needle, start)
    if offset == -1:
        offset = content.find(needle)               # fall back to anywhere
    if offset == -1:
        return None
    first = content.count("\n", 0, offset) + 1
    return first, first + raw_paragraph.count("\n")


def render_drift(item):
    newer = " (more recent)" if item["newer"] == "turtle" else ""
    older = " (more recent)" if item["newer"] == "prose" else ""
    alike = f"    [{item['ratio']:.0%} alike]" if item["ratio"] else ""
    return (f"- {item['term']} ({item['html_file']})\n"
            f"    turtle{newer}: {item['turtle']}\n"
            f"      last changed {describe(item['turtle_touch'])}\n"
            f"    prose{older}:  {item['prose'] or '(nothing comparable in the section)'}{alike}\n"
            f"      last changed {describe(item['prose_touch'])}")


def check_prose_matches_ontology(merged, defines, declared_by, deprecated):
    """Every paragraph of a term's definition appears in the term's section.

    When one does not, both sides are blamed, so the report says which of the
    two was edited last.
    """
    @graph merged

    fold = term_name_folder(defines)
    sections = {key: (file, fold(flat), [(fold(t), a, b) for t, a, b in blocks])
                for key, (file, flat, blocks) in specterm_sections().items()}
    everything = "\n".join(flat for _, flat, _ in sections.values())

    undocumented, drifted, parallel, elsewhere = [], [], 0, 0
    for term in sorted(defines):
        if term in deprecated or str(term).startswith(VOCABULARY_NS):
            continue
        definition = m{ {term} skos:definition ?d }.first()
        if definition is None:
            continue
        key = next((k for k in sections if anchor_matches(k, term)), None)
        if key is None:
            undocumented.append(term)
            continue

        turtle_file = declared_by.get(next(iter(defines[term]), None))
        html_file, flat, blocks = sections[key]

        for raw, paragraph in definition_paragraphs(definition):
            paragraph = fold(paragraph)
            # A definition ends in a full stop in one source and not in the
            # other about as often as not, and the prose opens the paragraph
            # with the term's label and a dash. Neither is a difference in
            # what the two say, so neither counts as one.
            bare = paragraph.rstrip(".;, ")
            if paragraph in flat or bare in flat:
                parallel += 1
            elif paragraph in everything or bare in everything:
                # Said once, in a shared passage another section links to.
                elsewhere += 1
            else:
                ratio, nearest, first, last = max(
                    ((difflib.SequenceMatcher(None, paragraph, text).ratio(), text, a, b)
                     for text, a, b in blocks), default=(0.0, "", 0, -1))

                turtle_span = locate_in_turtle(turtle_file, term, raw) if turtle_file else None
                turtle_touch = last_touched(turtle_file, *turtle_span) if turtle_span else None
                prose_touch = last_touched(html_file, first, last) if last >= first else None

                if not (turtle_touch and prose_touch):
                    newer = "unknown"
                elif turtle_touch[0] > prose_touch[0]:
                    newer = "turtle"
                elif prose_touch[0] > turtle_touch[0]:
                    newer = "prose"
                else:
                    newer = "same"

                drifted.append({"term": key, "html_file": html_file,
                                "turtle_file": turtle_file, "turtle": paragraph,
                                "prose": nearest, "ratio": ratio, "newer": newer,
                                "turtle_touch": turtle_touch, "prose_touch": prose_touch})

    print(f"\n=== Definitions: Turtle against the prose ===")
    print(f"{parallel} paragraph(s) match the documenting section, "
          f"{elsewhere} appear in shared prose elsewhere.")
    if drifted:
        counts = defaultdict(int)
        for item in drifted:
            counts[item["newer"]] += 1
        print(f"Of the {len(drifted)} that differ, the Turtle carries the more recent "
              f"edit in {counts['turtle']}, the prose in {counts['prose']}; "
              f"{counts['same']} were last changed by the same commit "
              f"and {counts['unknown']} could not be traced.")
    report(
        "Definitions that differ between the ontology and the prose", drifted,
        "The ontology and the prose say the same thing", fatal=False,
        detail=render_drift,
    )
    report(
        "Terms with a definition but no documenting section", undocumented,
        "Every defined term has a section", fatal=False,
    )


def check_labels_match_prose(merged, defines, deprecated):
    """A term's preferred and alternative labels appear in its section."""
    @graph merged
    sections = specterm_sections()

    missing = []
    for term in sorted(defines):
        if term in deprecated:
            continue
        key = next((k for k in sections if anchor_matches(k, term)), None)
        if key is None:
            continue
        flat = sections[key][1]
        for label in set(m{ {term} skos:prefLabel ?l }) | set(m{ {term} skos:altLabel ?l }):
            if str(label) not in flat:
                missing.append((key, sections[key][0], term, str(label)))

    report(
        "Labels absent from the term's section", missing,
        "Every preferred and alternative label is used in the prose", fatal=False,
        detail=lambda x: f"- {x[0]} ({x[1]}): {x[2]} is labelled \"{x[3]}\", not said in the section",
    )


def check_prefixes():
    """The same prefix means the same namespace in every Turtle file."""
    pattern = re.compile(r'@prefix\s+([A-Za-z0-9_.-]*):\s*<([^>]*)>')
    bindings = defaultdict(lambda: defaultdict(set))
    for file in sorted(Path(".").rglob("*.ttl")):
        for prefix, namespace in pattern.findall(read(file)):
            bindings[prefix][namespace].add(file)
    conflicts = sorted((p, sorted(ns.items())) for p, ns in bindings.items() if len(ns) > 1)
    report(
        "Prefixes bound to more than one namespace", conflicts,
        "Every prefix is used consistently", fatal=False,
        detail=lambda x: f"- {x[0]}:\n" + "\n".join(
            f"    - <{ns}> in {', '.join(str(f) for f in sorted(files))}" for ns, files in x[1]),
    )


def check_examples(defines, modules):
    """Examples must not invent SOSA/SSN terms, and should exercise them all."""
    used = set()
    undefined = defaultdict(set)
    for file in sorted(EXAMPLES_DIR.rglob("*.ttl")):
        try:
            example = Graph().parse(file, format="turtle")
        except Exception as error:
            print(f"❌ Error parsing example {file}: {error}")
            continue
        for term in {t for triple in example for t in triple if is_ours(t)} - modules:
            used.add(term)
            if term not in defines:
                undefined[term].add(file)

    report(
        "Undefined SOSA/SSN terms in examples", sorted(undefined),
        "Every term used in an example is defined", fatal=True,
        detail=lambda t: f"- {t} used in:\n" + "\n".join(f"    - {f}" for f in sorted(undefined[t])),
    )
    report(
        "Terms illustrated by no example", sorted(set(defines) - used),
        "Every term appears in an example", fatal=False,
    )


# ---------------------------------------------------------------------------

def main():
    report("Unused HTML chapters", unused_html_chapters(),
           "Every chapter is included")
    report("Unreferenced images", unreferenced_images(),
           "Every image is referenced")
    report("Unreferenced TTL files", unreferenced_ttl_files(),
           "Every data file is referenced")
    report("Dangling internal links", dangling_anchors(),
           "Every internal link resolves", fatal=True,
           detail=lambda x: f"- href=\"#{x[0]}\" in {x[1]} has no matching id")

    report("Invalid TTL files", invalid_ttl_files(),
           "Every Turtle file parses", fatal=True,
           detail=lambda x: f"- {x[0]}\n    {x[1]}")

    merged, declared_by, seen_in, module_problems = load_ontology()
    report("Ontology module declarations", module_problems,
           f"All {len(declared_by)} modules declare exactly one ontology", fatal=True,
           detail=lambda x: f"- {x[0]}: {x[1]}")

    check_publication(merged, declared_by)

    defines = check_terms(merged, declared_by, seen_in)
    deprecated = check_deprecated(merged, defines)
    check_annotations(merged, defines, deprecated)
    check_domains_and_ranges(merged, defines)
    check_documented(defines, deprecated)
    check_prose_matches_ontology(merged, defines, declared_by, deprecated)
    check_labels_match_prose(merged, defines, deprecated)
    check_prefixes()
    check_examples(defines, module_iris(merged))

    print()
    if FAILURES:
        print(f"❌ {len(FAILURES)} failing check(s): " + ", ".join(FAILURES))
        return 1
    print("✅ All checks passed.")
    return 0


if __name__ == "__main__":
    sys.exit(main())
