@prefix ex: <https://example.org/data/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix qk: <http://qudt.org/vocab/quantitykind/> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix schema: <http://schema.org/>.
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix sosa: <http://www.w3.org/ns/sosa/> .
@prefix time: <http://www.w3.org/2006/time#>.
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix system: <http://www.w3.org/ns/ssn/systems/> .
@prefix rdfp: <https://w3id.org/rdfp/>.
@base <https://example.org/data/dht22/> .

## definition of DHT22 sensor #4578

ex:DHT22_4578 a sosa:Sensor , sosa:System ;
  rdfs:comment "DHT22 sensor #4578 is a humidity and temperature sensor."@en ;
  rdfs:seeAlso <https://www.sparkfun.com/datasheets/Sensors/Temperature/DHT22.pdf> ;
  sosa:implements ex:DHT22_Procedure ;


## definition of the procedure it implements

ex:DHT22_Procedure a sosa:Procedure ;
  sosa:hasOutput ex:DHT22_output ;
.
ex:DHT22_output a prof:Profile ;
  rdfs:comment "The procedure's output is a RDF Graph that describes both the temperature and the humidity. It can be validated by a SHACL shapes graph."@en ;
  dct:conformsTo <http://www.w3.org/2001/XMLSchema#> ;
  prof:hasResource [
    a	prof:ResourceDescriptor ;
    dct:format <https://w3id.org/mediatype/text/turtle> ;
    dct:conformsTo <https://www.w3.org/TR/shacl/> ;
    prof:hasRole role:Validation
    prof:hasArtifact <http://example.org/profile/x/validation.ttl> ;
  ]
.

## definition of the operating range of ex:DHT22_4578

<operating_conditions> a sosa:ObservationCollection ;
  sosa:hasFeatureOfInterest ex:DHT22_4578 ;
  sosa:hasMember
    [ a sosa:Observation ;
      sosa:observedProperty system:MinOperatingTemperature ;
      sosa:hasResult [
        qudt:value -40.0 ;
        qudt:unit unit:DEG_C
      ]
    ] ,
    [ a sosa:Observation ;
      sosa:observedProperty system:MaxOperatingTemperature ;
      sosa:hasResult [
        qudt:value 80.0 ;
        qudt:unit unit:DEG_C
      ]
    ] ,
    [ a sosa:Observation ;
      sosa:observedProperty system:MinOperatingRelativeHumidity ;
      sosa:hasResult [
        qudt:value 0.0 ;
        qudt:unit unit:PERCENT
      ]
    ] ,
    [ a sosa:Observation ;
      sosa:observedProperty system:MaxOperatingRelativeHumidity ;
      sosa:hasResult [
        qudt:value 100.0 ;
        qudt:unit unit:PERCENT
      ]
    ] ,
    [ a sosa:Observation ;
      sosa:observedProperty system:MinOperatingVoltage ;
      sosa:hasResult [
        qudt:value 3.3 ;
        qudt:unit unit:V
      ]
    ] ,
    [ a sosa:Observation ;
      sosa:observedProperty system:MaxOperatingVoltage ;
      sosa:hasResult [
        qudt:value 6.0 ;
        qudt:unit unit:V
      ]
    ] .

## definition of normal operating conditions of ex:DHT22_4578

<normal_operating_conditions> a sosa:ObservationCollection ;
  sosa:hasFeatureOfInterest ex:DHT22_4578 ;
  sosa:hasMember 
  [ a sosa:Observation ;
    sosa:observedProperty ex:MinTemperature ;
    sosa:hasResult [
      qudt:value -40.0 ;
      qudt:unit unit:DEG_C
    ]
  ] ,
  [ a sosa:Observation ;
    sosa:observedProperty ex:MaxTemperature ;
    sosa:hasResult [
      qudt:value 80.0 ;
      qudt:unit unit:DEG_C
    ]
  ] ,
  [ a sosa:Observation ;
    sosa:observedProperty ex:MinRelativeHumidity ;
    sosa:hasResult [
      qudt:value 5.0 ;
      qudt:unit unit:PERCENT
    ]
  ] ,
  [ a sosa:Observation ;
    sosa:observedProperty ex:MaxRelativeHumidity ;
    sosa:hasResult [
      qudt:value 85.0 ;
      qudt:unit unit:PERCENT
    ]
  ]
.

<temperature_capabilities> a sosa:ObservationCollection ;
  sosa:hasFeatureOfInterest ex:DHT22_4578 ;
  sosa:forProperty qk:Temperature ;
  sosa:inCondition <normal_operating_conditions> ;
  sosa:hasMember 
    [ a sosa:Observation ;
      sosa:observedProperty system:Accuracy ;
      sosa:hasResult [
        qudt:value 0.5 ;
        qudt:unit unit:DEG_C
      ]
    ] ,
    [ a sosa:Observation ;
      sosa:observedProperty system:Sensitivity ;
      sosa:hasResult [
        qudt:value 0.1 ;
        qudt:unit unit:DEG_C
      ]
    ] ,
    [ a sosa:Observation ;
      sosa:observedProperty system:Resolution ;
      sosa:hasResult [
        qudt:value 0.1 ;
        qudt:unit unit:DEG_C
      ]
    ] ,
    [ a sosa:Observation ;
      sosa:observedProperty system:Precision ;
      sosa:hasResult [
        qudt:value 0.2 ;
        qudt:unit unit:DEG_C
      ]
    ] ,
    [ a sosa:Observation ;
      sosa:observedProperty system:Frequency ;
      sosa:hasResult [
        qudt:value 2 ;
        qudt:unit unit:Second
      ]
    ]
.

ex:observation_1087 a sosa:Observation ;
  sosa:observedProperty qk:Temperature ;
  sosa:madeBySensor ex:DHT22_4578 ;
  sosa:usedProcedure ex:DHT22_Procedure ;
  sosa:resultQuality ex:observation_1087_quality ;
  sosa:hasResult [
    qudt:value 21.4 ;
    qudt:unit unit:DEG_C
  ]
.

# one may use some other ontology to further qualify this quality

ex:observation_1087_quality 
  ex:evaluatedBy ex:Tom ;
  ex:confidenceValue "6"^^xsd:integer ;
  rdfs:comment """Tom gave a confidence value of 6 out of 10 on this observation."""@en ;
.
# one may use some quantity ontology

@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix unit: <http://qudt.org/vocab/unit/> .

ex:observation_1087_quality rdf:type qudt:Quantity ;
  qudt:quantityValue [
    rdf:type qudt:QuantityValue ;
    qudt:numericValue "98.4"^^xsd:double ;
    qudt:hasUnit unit:PERCENT ] .