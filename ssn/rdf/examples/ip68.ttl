@prefix ex: <https://example.org/data/> .
@prefix geo: <http://www.opengis.net/ont/geosparql#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix qk: <http://qudt.org/vocab/quantitykind/> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix schema: <http://schema.org/>.
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix sosa: <http://www.w3.org/ns/sosa/> .
@prefix time: <http://www.w3.org/2006/time#>.
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix system: <http://www.w3.org/ns/ssn/systems/> .
@prefix rdfp: <https://w3id.org/rdfp/>.
@prefix gr: <http://purl.org/goodrelations/v1#> .
@prefix prov: <http://www.w3.org/ns/prov#>.
@prefix seas: <https://w3id.org/seas/>.
@prefix cdt: <http://w3id.org/lindt/custom_datatypes#>.
@base <https://data.grandlyon.com/> .

ex:Organization_1 a prov:Organization ;
    owl:sameAs <http://dbpedia.org/page/Metropolis_of_Lyon> ;
.
ex:Air a sosa:FeatureOfInterest ;
  rdfs:label "The air."@en ;
  owl:sameAs <https://www.wikidata.org/wiki/Q3230> . 

ex:IP68_Outdoor_Temperature_Sensor a owl:Class , gr:ProductOrServiceModel ;
  rdfs:label "IP68 Outdoor Temperature Sensor"@en .
  rdfs:subClassOf [
    owl:onProperty sosa:implements ;
    owl:hasValue ex:IP68_Outdoor_Temperature_Sensor_temperatureSensingProcedure ] ;
  rdfs:subClassOf [
    owl:onProperty sosa:implements ;
    owl:hasValue ex:IP68_Outdoor_Temperature_Sensor_batterySensingProcedure ] ;
  rdfs:subClassOf [
    owl:onProperty sosa:observes ;
    owl:hasValue ex:BatteryLevel ] ;
  rdfs:subClassOf [
    owl:onProperty sosa:observes ;
    owl:hasValue ex:Temperature ] ;
  rdfs:subClassOf [
    owl:onProperty sosa:isFeatureOfInterestOf ;
    owl:hasValue ex:IP68_Outdoor_Temperature_Sensor_minOperatingRange ] ;
  rdfs:subClassOf [
    owl:onProperty sosa:isFeatureOfInterestOf ;
    owl:hasValue ex:IP68_Outdoor_Temperature_Sensor_maxOperatingRange ] ;
  rdfs:subClassOf [
    owl:onProperty sosa:isFeatureOfInterestOf ;
    owl:hasValue ex:IP68_Outdoor_Temperature_Sensor_TemperatureAccuracy ] ;
  rdfs:subClassOf [
    owl:onProperty sosa:isFeatureOfInterestOf ;
    owl:hasValue ex:IP68_Outdoor_Temperature_Sensor_TemperatureResolution ] ;
  rdfs:subClassOf [
    owl:onProperty sosa:isFeatureOfInterestOf ;
    owl:hasValue ex:IP68_Outdoor_Temperature_Sensor_BatteryResolution ] ;
.
ex:IP68_Outdoor_Temperature_Sensor_minOperatingRange a system:SystemObservation ;
  sosa:observedProperty system:MinOperatingTemperature ;
  sosa:hasResult [ 
    qudt:value -20.0 ;
    qudt:unit unit:DEG_C
  ]
.
ex:IP68_Outdoor_Temperature_Sensor_maxOperatingRange a system:SystemObservation ;
  sosa:observedProperty system:MaxOperatingTemperature ;
  sosa:hasResult [ 
    qudt:value 70.0 ;
    qudt:unit unit:DEG_C
  ]
.
ex:IP68_Outdoor_Temperature_Sensor_TemperatureAccuracy a system:SystemObservation ;
  sosa:observedProperty system:Accuracy ;
  sosa:forProperty qk:Temperature ;
  sosa:hasResult [
    qudt:value 0.2 ;
    qudt:unit unit:DEG_C 
  ]
.
ex:IP68_Outdoor_Temperature_Sensor_TemperatureResolution a system:SystemObservation ;
  sosa:observedProperty system:Resolution ;
  sosa:forProperty ex:BatteryLevel ;
  sosa:isPropertyOf ex:Air ;
  sosa:hasResult [
    qudt:value 0.0625 ;
    qudt:unit unit:DEG_C 
  ]
.
ex:IP68_Outdoor_Temperature_Sensor_BatteryResolution a system:SystemObservation ;
  sosa:observedProperty system:Resolution ;
  sosa:forProperty ex:BatteryLevel ;
  sosa:hasResult [
    qudt:value 3.937e-3 ;
    qudt:unit unit:PERCENT 
  ]
.
ex:Air_4575_485 a sosa:Sample ;
  rdfs:label "The air at lat 45.75 and long 4.85."@en ;
  sosa:isSampleOf ex:Air ;
  geo:hasGeometry [ 
    a geo:Point ;
    geo:asWKT "POINT (4.85 45.75)"^^geo:WktLiteral ;
  ] ;
  sosa:hasProperty qk:Temperature ;
.
ex:Sensor_SL-T-P1 a gr:ProductOrService, sosa:Sensor , seas:LoRaCommunicationDevice , ex:IP68_Outdoor_Temperature_Sensor ;
    gr:hasBrand [ a gr:Brand ; gr:name "Sensing Labs"@en ] ;
    geo:alt 100.0 ;
    geo:lat 45.75 ;
    geo:lon 4.85 ;
    sosa:implements ex:IP68_Outdoor_Temperature_Sensor_temperatureSensingProcedure ;
    sosa:implements ex:IP68_Outdoor_Temperature_Sensor_batterySensingProcedure ;
    sosa:observes ex:BatteryLevel ;
    sosa:observes qk:Temperature ;
.
ex:Deployment_SL-T-P1_2017-06-06 a sosa:Deployment ;
  sosa:deployedSystem ex:Sensor_SL-T-P1 ;
  sosa:startTime "2017-06-06"^^xsd:date ;
  prov:wasAssociatedWith ex:Organization_1 ;
  sosa:deployedOnPlatform ex:Tree_1 ;
.
ex:Observation_5872357_temperature a sosa:Observation ;
  sosa:madeBySensor ex:Sensor_SL-T-P1 ;
  sosa:hasFeatureOfInterest ex:Air_4575_485 ;
  sosa:observedProperty qk:Temperature ;
  sosa:resultTime "2017-06-20T21:49:18+00:00"^^xsd:dateTime ;
  sosa:hasResult [
    qudt:value 64.5244681928429 ;
    qudt:unit unit:DEG_C 
  ]
.
ex:Observation_5872357_battery a sosa:Observation ;
  sosa:madeBySensor ex:Sensor_SL-T-P1 ;
  sosa:hasFeatureOfInterest ex:Sensor_SL-T-P1 ;
  sosa:observedProperty ex:BatteryLevel ;
  sosa:resultTime "2017-06-20T21:49:18+00:00"^^xsd:dateTime ;
  sosa:hasResult [
    qudt:value 73.2 ;
    qudt:unit unit:PERCENT 
  ]
.