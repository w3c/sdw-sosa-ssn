    a sosa:FeatureOfInterest ;  
.
ex:LOIRE_A_JARGEAU_WQ_Station 
    a sosa:Platform ;  
. 
ex:SA56 
    a sosa:Sampler ;
    sosa:implements ex:sampling-A56 ;
    sosa:madeSamplingHasResult [
        a sosa:SampleCollection ;
     ] ;
.
ex:sampling-A56 
    a sosa:SamplingProcedure ;
. 
