# baseURI: http://www.w3.org/ns/sosa/prov
# imports: http://www.w3.org/ns/prov-o#
# imports: http://www.w3.org/ns/sosa/

@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix sosa: <http://www.w3.org/ns/sosa/> .
@prefix sp: <http://www.w3.org/ns/sosa/prov/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

sosa:Execution
  rdfs:subClassOf prov:Activity ;
.
sosa:Actuation
  rdfs:subClassOf prov:Activity ;
.
sosa:Observation
  rdfs:subClassOf prov:Activity ;
.
sosa:Sampling
  rdfs:subClassOf prov:Activity ;
.
sosa:Deployment
  rdfs:subClassOf prov:Activity ;
.
sosa:Asset
  rdfs:subClassOf [
    a owl:Class ;
    owl:unionOf (
      prov:Agent 
      prov:Entity 
    )
  ] ;
.
sosa:System
  rdfs:subClassOf [
    a owl:Class ;
    owl:unionOf (
      prov:Agent 
      prov:Entity 
    )
  ] ;
.
sosa:Platform
  rdfs:subClassOf prov:Entity ;
.
sosa:Procedure
  rdfs:subClassOf prov:Plan ;
.
sosa:FeatureOfInterest
  rdfs:subClassOf prov:Entity ;
.
sosa:Sample
  rdfs:subClassOf prov:Entity ;
.
sosa:Property
  rdfs:subClassOf prov:Entity ;
.
sosa:hasFeatureOfInterest
  rdfs:subPropertyOf prov:used ;
.
sosa:hasResult
  rdfs:subPropertyOf prov:generated ;
.
sosa:isResultOf
  rdfs:subPropertyOf prov:wasGeneratedBy ;
.
sosa:isSampleOf
  rdfs:subPropertyOf prov:wasDerivedFrom ;
.
sosa:madeBySystem
  rdfs:subPropertyOf prov:wasAssociatedWith ;
.
sosa:startTime
  rdfs:subPropertyOf prov:startedAtTime ;
.
sosa:endTime
  rdfs:subPropertyOf prov:endedAtTime ;
.
sosa:prov
  rdf:type owl:Ontology ;
  dcterms:created "2016-12-14"^^xsd:date ;
  dcterms:creator "Simon J D Cox" ;
  dcterms:creator "W3C/OGC Spatiotemporal Data on the Web Working Group"@en ;
  dcterms:license <http://www.opengeospatial.org/ogc/Software> ;
  dcterms:license <http://www.w3.org/Consortium/Legal/2015/copyright-software-and-document> ;
  dcterms:modified "2026-02-22"^^xsd:date ;
  dcterms:rights "Copyright 2017, 2026 W3C/OGC." ;
  rdfs:comment "Alignment of the the W3C/OGC SOSA Ontology with the W3C PROV-O Ontology"@en ;
  rdfs:label "Alignment of SOSA with PROV-O"@en ;
  owl:imports <http://www.w3.org/ns/prov-o#> ;
  owl:imports sosa: ;
.
sp:executionAssociation
  rdf:type owl:ObjectProperty ;
  rdfs:domain sosa:Execution ;
  rdfs:subPropertyOf prov:qualifiedAssociation ;
  rdfs:label "execution association"@en ;
  skos:definition "Relation between an Execution and an Association which describes some aspects of that Execution."@en ;
  rdfs:isDefinedBy sp: .
sp:hadProcedure
  rdf:type owl:ObjectProperty ;
  rdfs:range sosa:Procedure ;
  rdfs:subPropertyOf prov:hadPlan ;
  rdfs:label "had procedure"@en ;
  skos:definition "Relation between an Association and a Procedure."@en ;
  rdfs:isDefinedBy sp: .
sosa:usedProcedure
  owl:propertyChainAxiom (
      sp:executionAssociation
      sp:hadProcedure
    ) ;
.
